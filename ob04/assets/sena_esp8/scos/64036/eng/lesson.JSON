{"_data": [{"contents": [{"type": "lesson_name", "content": ""}, {"type": "unit_name", "content": "Maintenance and Support for Software License Agreements "}, {"type": "position", "content": 4}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 3}, {"type": "level", "content": "B1.3"}], "type": "metadata"}, {"contents": [{"type": "test", "content": "false"}], "type": "achievment_test"}, {"contents": [{"type": "text", "content": "These are words you use when talking about software maintenance and technical support."}], "type": "target_word_describer"}, {"contents": [{"type": "primary", "content": "Understand information about people's backgrounds in spoken or written documents.   Participate in the improvement of IT contracts, establishing technical clauses that respond to the needs of the negotiating agents, based on current laws on contracting."}, {"type": "secondary_1", "content": "Understand information about people's backgrounds in spoken or written documents.   Participate in the improvement of IT contracts, establishing technical clauses that respond to the needs of the negotiating agents, based on current laws on contracting."}], "type": "objectives"}, {"type": "background_image", "content": "enpe8n7le03ob04re1img01.jpg"}, {"contents": [{"type": "text", "content": "Look for information about software maintenance and technical support."}, {"type": "text", "content": "Describe their differences and main characteristics."}, {"type": "text", "content": "Write a comparison chart to differentiate those two concepts, qualities and considerations in regards to their duration."}, {"type": "text", "content": "Share the chart with your classmates."}], "type": "takeaway_extension"}, {"contents": [{"type": "text", "content": "I look for information about software maintenance and technical support."}, {"type": "text", "content": "I describe their differences and features."}, {"type": "text", "content": "I write a comparison chart."}, {"type": "text", "content": "I share the comparison chart with my classmates."}], "type": "takeaway_assessment"}, {"contents": [{"type": "name", "content": "exclusion"}, {"type": "definition", "content": "specific condition or circumstance included in a contract as not covered"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "What about exclusions and qualifications?"}, {"type": "audio", "content": "enpe8n7le03ob04aud01"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "helpdesk service"}, {"type": "definition", "content": "a resource created to provide the customer with information and support regarding the proper use of a service or product"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "A helpdesk service, known as \u201cfirst level support\u201d, might be included in the technical support."}, {"type": "audio", "content": "enpe8n7le03ob04aud02"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "qualification"}, {"type": "definition", "content": "part of a contract that contains reservations and restrictions"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "What about exclusions and qualifications? "}, {"type": "audio", "content": "enpe8n7le03ob04aud03"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "remote technical advice "}, {"type": "definition", "content": "remote assistance provided by companies to technology users "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Technical support, on the other hand, refers to remote technical advice for the correct use of the software and assistance to solve related problems."}, {"type": "audio", "content": "enpe8n7le03ob04aud04"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "software patch"}, {"type": "definition", "content": "record of changes made to a set of resources"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Well, software maintenance usually is about software patches and fixes, and software updates."}, {"type": "audio", "content": "enpe8n7le03ob04aud05"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "upgrade"}, {"type": "definition", "content": "a software that enables enhancements over the earlier version of another software or program "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Sometimes, these can mean major upgrades or newer versions of the licensed software."}, {"type": "audio", "content": "enpe8n7le03ob04aud06"}], "type": "target_word"}, {"contents": [{"type": "heading", "content": "The Passive of Modal Verbs: May and Might"}, {"type": "describer", "content": " We use the <span class=\"strong\">passive voice </span> when we want to give importance to the object of a sentence or when the subject is not important or unknown."}, {"type": "example", "content": "A helpdesk service, known as \u201cfirst level support\u201d, might be included in the technical support, or by not including helpdesk assistance, some companies offer second level support, which might be limited to the customer's internal helpdesk personnel. "}, {"type": "example", "content": "Good, but let me add that limited remedies might be offered if the software vendor fails to provide the promised level of service."}, {"type": "example", "content": "For example, this support may be limited to current versions of the software, or difficulties caused by use of software in breach of the software license agreement might be excluded."}, {"type": "text", "content": "We use the <span class=\"strong\">passive form </span> of the modal verbs <span class=\"strong\">may</span>  and <span class=\"strong\">might</span>  to talk about situations that are likely to happen and whose doer is not important. </br></br>  However, there is a subtle difference between the two of them. We use <span class=\"strong\">may</span>  to express that something is possible but <span class=\"strong\">might</span>  to suggest a lower possibility. </br>"}, {"type": "table", "content": "{\"rows\":2,\"columns\":4,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Object </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">may/might</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">be</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">main verb (past participle) or complement</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">The acquisition of this software </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">might</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">be </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">optional. </span>\\\"}\"],\"styles\":\"\"}"}], "type": "learning_points"}, {"contents": [{"type": "heading", "content": "Verb + Ing After Prepositions, Position of Not"}, {"type": "describer", "content": " If we want to use a <span class=\"strong\">verb after a preposition</span>, it always has to go in its \u2013ING (gerund) form. "}, {"type": "example", "content": "By establishing these, the software vendor's obligations are limited."}, {"type": "example", "content": "By not including helpdesk assistance, some companies offer second level support, which might be limited to the customer's internal helpdesk personnel. "}, {"type": "example", "content": "However, this kind of service is usually limited by the vendor and by doing this, problems may appear for the customer if they want to use the licensed software for a lengthy period of time.  "}, {"type": "text", "content": "Prepositions are usually followed by <span class=\"strong\">noun- phrases </span>. If we want to include a verb (as the subject of the sentence) it must be in the <span class=\"strong\"> gerund form</span>. An infinitive (to-) can never be placed there. "}, {"type": "text", "content": "If you are going to use the negative form, you just have to put the particle <span class=\"strong\">not </span> before the gerund. "}, {"type": "text", "content": "For example:"}, {"type": "text", "content": "<i>By <span class=\"strong\">not guaranteeing </span> helpdesk assistance, companies may offer different types of supports.</i> "}], "type": "learning_points"}], "type": "sena", "labs": [{"stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"_data": [], "title": "", "type": "audio", "template_override": 1, "id": 1, "contents": [{"value": {"audiosrc": "enpe8n7le03ob04re2aud01", "images": [{"time": "0", "image": "enpe8n7le03ob04re2img01.jpg", "id": 0, "text": "<span class=\"strong\"> Trainer: </span>As you know, software license agreements come with offerings of important services to guarantee the correct use and performance of the licensed software. These are typically known as \u201cSoftware maintenance\u201d and \u201cTechnical support\u201d. Can anyone tell me what the differences between these two are? </br>\n<span class=\"strong\"> Trainee: </span> Well, software maintenance is usually about software patches and fixes, and software updates. Sometimes, these can mean major upgrades or newer versions of the licensed software. Technical support, on the other hand, refers to remote technical advice for the correct use of the software and assistance to solve related problems. A helpdesk service, known as \u201cfirst level support\u201d, might be included in the technical support, or by not including helpdesk assistance, some companies offer second level support, which might be limited to the customer's internal helpdesk personnel. </br>"}, {"time": "57000", "image": "enpe8n7le03ob04re2img02.jpg", "id": 1, "text": "<span class=\"strong\"> Trainer: </span> Good, but let me add that limited remedies might be offered if the software vendor fails to provide the promised level of service. What about exclusions and qualifications? </br>\n<span class=\"strong\"> Trainee: </span> By establishing these, the software vendor's obligations are limited. For example, this support may be limited to current versions of the software, or difficulties caused by the use of software in breach of the software license agreement might be excluded. Problems that may be replicated by the software vendor in the software vendor's technical support environment might also be limited. </br>"}, {"time": "93500", "image": "enpe8n7le03ob04re2img03.jpg", "id": 2, "text": "<span class=\"strong\"> Trainer: </span> Great answer! Finally, do you have anything to say about the duration of the service? </br>\n<span class=\"strong\"> Trainee: </span> According to the customer's preference, software maintenance and technical support might be optional. However, this kind of service is usually limited by the vendor and by doing this, problems may appear for the customers if they want to use the licensed software for a lengthy period of time. </br>"}], "coverimg": "enpe8n7le03ob04re2img01.jpg"}, "type": "slideshow"}]}], "exercises": [{"stimuli_ids": [0], "_data": [{"contents": [{"type": "Learning Outcomes", "content": "I can talk about the concepts of maintenance and support in a software license agreement."}, {"type": "Learning Outcomes", "content": "I can talk about exclusions and qualification for software maintenance and technical support."}, {"type": "Learning Outcomes", "content": "I can discuss considerations in regards to the duration of service for software maintenance and technical support."}, {"type": "Free Header Item", "content": "Do you think software maintenance and technical support are important when acquiring licensed software? Why? Why not?"}, {"type": "Free Header Item", "content": "How long do you think this service should last? Why? "}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Welcome"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": "You have 2 tries"}, {"type": "text", "content": "you have 1 attempt left"}], "correct_feedback": "Correct", "incorrect_feedback": [{"type": "text", "content": "try again"}, {"type": "text", "content": "Maybe next time"}], "allowed_attempts": 2}}, {"type": "free_header_text", "content": "Ask your partner:"}, {"type": "free_type_text_area", "content": "Using Software Maintenance and Technical Support to the Fullest"}], "questions": [], "type": "WLC", "template_override": 1, "id": 0, "img_path": ""}, {"stimuli_ids": [1], "_data": [{"contents": [{"type": "text", "content": " A trainer is instructing his trainees on software maintenance and technical support."}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Content"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "", "incorrect_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "allowed_attempts": 2}}, {"contents": [{"type": "skill", "content": "Listening"}, {"type": "skill", "content": "Reading"}], "type": "learning_skills"}, {"contents": [{"type": "text", "content": "Instructions: Click on the play button to listen to the audio."}], "type": "post_instructions"}], "questions": [{"_data": [{"contents": [{"type": "text", "content": ""}], "type": "question"}], "responses": [{"correct": 0, "selected": 0, "_data": [{"type": "text", "content": ""}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"type": "text", "content": ""}], "id": 1}], "id": 0}], "type": "STI", "template_override": 1, "id": 1}, {"stimuli_ids": [], "_data": [{"contents": [{"type": "text", "content": "Software Maintenance and Technical Support, Any Difference?"}], "type": "instructions"}, {"cont