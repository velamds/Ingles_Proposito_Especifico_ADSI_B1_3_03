ted": 0, "_data": [{"type": "text", "content": ""}], "id": 1}], "id": 2}, {"_data": [{"contents": [{"type": "text", "content": "The customer is supposed to __________ all the pros and cons of general indemnity provisions. "}, {"type": "text", "content": "(Hint: to comprehend)"}], "type": "question"}, {"type": "objective", "content": "secondary_1"}], "responses": [{"correct": 1, "selected": 0, "_data": [{"type": "text", "content": "understand"}], "id": 0}, {"correct": 0, "selected": 0, "_data": [{"type": "text", "content": ""}], "id": 1}], "id": 3}, {"_data": [{"contents": [{"type": "text", "content": "The software vendors are supposed to ________the other party against third party claims. "}, {"type": "text", "content": "(Hint: to assure)"}], "type": "question"}, {"type": "objective", "content": "secondary_1"}], "responses": [{"correct": 0, "selected": 0, "_data": [{"type": "text", "content": "protect "}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"type": "text", "content": ""}], "id": 1}], "id": 4}], "type": "DMC", "template_override": 1, "id": 12}], "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"_data": [], "title": "", "type": "video", "template_override": 1, "id": 3, "contents": [{"value": {"video_src": "enpe8n7le03ob07re2vid01", "images": [{"time": "0", "image": "", "id": 0, "text": "<div align=\"justify\"><strong>Vendor</strong>: So, Mr. Shaw, before you sign this software license agreement, I'd like to talk to you about the indemnities. As you probably know, indemnities are designed to impose obligations on the parties in case there is a claim by a third party. You, as the customer, are supposed to understand the burdens and benefits of general indemnities provisions.<br/>"}, {"time": "20000", "image": "", "id": 1, "text": "<strong>Customer</strong>: I understand that, but how is that supposed to work out with a software agreement?<br/>"}, {"time": "24500", "image": "", "id": 2, "text": "<strong>Vendor</strong>: Well, for starters, the main purpose of a general indemnity main is to contractually allocate the risk of claims by, as I said, third parties against the contracting parties. This allocation can be based on fault (the risk is allocated to the contracting party whose acts or omissions regarding the software caused the third party claim), or on efficiency (the risk is allocated to the contracting party who is best to manage the third party claim).<br/>"}, {"time": "54500", "image": "", "id": 3, "text": "<strong>Customer</strong>: What about obligations?<br/>"}, {"time": "56000", "image": "", "id": 4, "text": "<strong>Vendor</strong>: Well, there are two main obligations from the indemnifying party you should always count on: an obligation to stand up for the beneficiary when third party claims occur, and an obligation to reimburse and protect the beneficiary from obligations and liabilities resulting from those claims.<br/>"}, {"time": "73500", "image": "", "id": 5, "text": "<strong>Customer</strong>: What about its extent?<br/>"}, {"time": "75500", "image": "", "id": 6, "text": "<strong>Vendor</strong>: The scope of a general indemnity is adjusted per who the beneficiaries are supposed to be: the contracting party's personnel or other related persons; to certain kinds of claims, like damage to property or bodily injury; to the time the agreement lasts or after it is ended; and according to a limit on the financial limitations from the indemnifying party, which include the number of legal fees paid to defend claims or to satisfy resulting liabilities."}]}, "type": "video"}]}], "type": "scholar", "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "id": 0}]}